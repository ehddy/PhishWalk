# Model provider: openai, anthropic, google_genai, or openrouter
PHISHWALK_MODEL_PROVIDER=openai
PHISHWALK_MODEL_NAME=<provider-model-id>
PHISHWALK_MODEL_TEMPERATURE=0.0

# Maximum validated ActionPlan steps before the final verdict
PHISHWALK_MAX_ACTION_PLAN_STEPS=5

# Retries after an invalid ActionPlan response
PHISHWALK_MAX_VALIDATION_RETRIES=2

# Retries for transient provider errors (e.g. HTTP 429) on a single model call
PHISHWALK_MAX_PROVIDER_ERROR_RETRIES=3

# Time limit for each target URL
PHISHWALK_TARGET_TIMEOUT_SECONDS=300

# Browser actions available to the model (press_enter and go_back are optional).
# finish is always available; handle_dialog is offered when a dialog is pending.
PHISHWALK_ENABLED_ACTIONS=click,fill,mouse_move,drag,hold,scroll,wait

# Traversal policy: phishwalk, generic, or one_shot
# one_shot requires PHISHWALK_ENABLED_ACTIONS=
PHISHWALK_TRAVERSAL_POLICY=phishwalk

# Browser settings (BROWSER_HEADLESS must be true under Docker)
BROWSER_HEADLESS=true
BROWSER_USER_AGENT="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/147.0.0.0 Safari/537.36"
BROWSER_LOCALE=en-US
BROWSER_TIMEZONE_ID=UTC
BROWSER_VIEWPORT_WIDTH=1280
BROWSER_VIEWPORT_HEIGHT=720

# API keys: set only the one for your provider
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
